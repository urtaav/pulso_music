<?xml version="1.0" encoding="utf-8"?>
<!-- Portada reutilizada por los tres tamaños. clipToOutline redondea la imagen (Android 12+). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_art_bg"
        android:clipToOutline="true"
        android:contentDescription="@string/widget_art"
        android:scaleType="centerCrop" />
    <ImageView
        android:id="@+id/widget_art_placeholder"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_music" />
</FrameLayout>
