<?xml version="1.0" encoding="utf-8"?>
<!-- Portada a sangre completa con degradado, progreso y cápsula de vidrio. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_dark"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/cover_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_art"
        android:scaleType="centerCrop" />
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim" />
    <ImageView
        android:layout_width="40dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_wave" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/cover_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/cover_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <ImageView
                android:id="@+id/cover_heart"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/widget_favorite"
                android:padding="11dp"
                android:src="@drawable/ic_widget_heart" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cover_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">
            <ProgressBar
                android:id="@+id/cover_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="1000"
                android:progressDrawable="@drawable/widget_progress" />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <Chronometer
                    android:id="@+id/cover_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/cover_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/cover_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/widget_previous"
                android:padding="13dp"
                android:src="@drawable/ic_widget_prev" />
            <LinearLayout
                android:id="@+id/cover_play"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/widget_pill"
                android:contentDescription="@string/widget_play_pause"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="24dp">
                <ImageView
                    android:id="@+id/cover_play_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_pause" />
                <TextView
                    android:id="@+id/cover_play_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/cover_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/widget_next"
                android:padding="13dp"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>